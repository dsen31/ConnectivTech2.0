# Existing public Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only access control settings (never prefix these with NEXT_PUBLIC_)
APP_OWNER_EMAILS=
SUPABASE_SERVICE_ROLE_KEY=

# Dedicated domain Gmail integration (all server-only)
APP_URL=https://your-staging-app.example
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OUTREACH_SENDER_EMAIL=
OUTREACH_SENDING_DOMAIN=
GOOGLE_DKIM_SELECTOR=google
# Independent random secrets. Token key: exactly 32 bytes, base64 encoded.
OUTREACH_TOKEN_KEY=
OUTREACH_UNSUBSCRIBE_KEY=
OUTREACH_WORKER_SECRET=
OUTREACH_SENDER_NAME=
OUTREACH_POSTAL_ADDRESS=
# Keep false until explicit authorization and staging acceptance.
OUTREACH_SEND_ENABLED=false
